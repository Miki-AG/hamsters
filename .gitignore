# macOS System Files
.AppleDouble
.LSOverride
._*
Icon
.Spotlight-V100
.Trashes

# Cloned / Bred Hamster Bundles (keep the founder bundle only)
hamster-*.command
Hamster-*.command
/main.colony/*/
!main.colony/hamster-founder/
!main.colony/hamster-founder/**

# Per-Hamster runtime state
.hamster/

# Working queue contents (keep the founder's input examples)
**/input/**
**/output/**
!main.colony/hamster-founder/output/
!main.colony/hamster-founder/output/.gitkeep

# Local worker assets (the founder exceptions are listed below)
**/instructions/**
**/skills/**
**/tools/**

# The founder is the checked-in working example
!main.colony/hamster-founder/input/
!main.colony/hamster-founder/input/**
!main.colony/hamster-founder/instructions/
!main.colony/hamster-founder/instructions/**
!main.colony/hamster-founder/skills/
!main.colony/hamster-founder/skills/**
!main.colony/hamster-founder/tools/
!main.colony/hamster-founder/tools/**

# Local colonies (keep the canonical colony)
/*.colony/
!/main.colony/

# Logs and Runtime State
*.log
*.pid
*.pid.lock
*.tmp
*.swp
*~

# IDE & Editor Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Agent customizations & local playbooks
.agents/
AGENTS.md

# Ignore Finder metadata even inside the founder bundle
**/.DS_Store
